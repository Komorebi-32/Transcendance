# Copy to .env and change the passwords: cp .env.example .env
# .env is never committed. Every variable names its owner group.

# ── Database (owner: A) ─────────────────────────────
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcendence

# ── Proxy (owner: A) ────────────────────────────────
# Host ports. 8443/8080 work without root; use 443/80 if your Docker allows it.
HTTPS_PORT=8443
HTTP_PORT=8080

# There's no DATABASE_URL here on purpose. 
# The compose file will build it from the three POSTGRES_ values, 
# so the password exists in one place only.

# Host port of the database, for local development (pnpm dev) only
DB_PORT=5432